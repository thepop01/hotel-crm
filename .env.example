# ============================================================
# Hotel Management App — Environment Variables Reference
# ============================================================
# Copy this file to .env.local (never commit .env.local to git)
# All secrets must be set via environment variables; never
# hardcode values in source files.
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development                      # development | production | test
PORT=3000                                 # Backend API server port
LOG_LEVEL=info                            # debug | info | warn | error

# ── Database (PostgreSQL — Production) ──────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hotel_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false                        # Set to true in production

# ── Database (SQLite — MCP / Development Inspection) ────────
SQLITE_DB_PATH=./data/hotel.db            # Used by mcp-server-sqlite

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=8h                         # Guest sessions
JWT_STAFF_EXPIRES_IN=12h                  # Staff sessions

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── File Storage (S3-compatible) ────────────────────────────
STORAGE_PROVIDER=local                    # local | s3 | gcs
S3_BUCKET=hotel-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_ENDPOINT=                              # Leave blank for AWS; set for MinIO/Cloudflare R2
LOCAL_UPLOAD_DIR=./data/uploads           # Used when STORAGE_PROVIDER=local

# ── Payment Gateway ─────────────────────────────────────────
PAYMENT_GATEWAY=razorpay                  # razorpay | stripe
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── WhatsApp Business API ────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false                         # true for port 465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@your-hotel.com

# ── OTA Platform Integrations ───────────────────────────────
BOOKING_COM_API_KEY=your-booking-com-api-key
BOOKING_COM_PROPERTY_ID=your-property-id
EXPEDIA_API_KEY=your-expedia-api-key
EXPEDIA_PROPERTY_ID=your-expedia-property-id
AIRBNB_API_KEY=your-airbnb-api-key
AIRBNB_LISTING_ID=your-airbnb-listing-id

# ── GST / Tax ────────────────────────────────────────────────
GSTIN=22AAAAA0000A1Z5                     # 15-digit GSTIN for the property
GST_REGISTERED_NAME=Your Hotel Pvt Ltd
GST_ADDRESS=123 Hotel Street, City, State - 000000

# ── Multi-Property ───────────────────────────────────────────
DEFAULT_PROPERTY_ID=property-uuid-here
MULTI_PROPERTY_ENABLED=false

# ── WebSocket ────────────────────────────────────────────────
WS_PORT=3001                              # WebSocket server port (same host as API)
WS_HEARTBEAT_INTERVAL=30000              # ms

# ── Cron Jobs (Meal Plan Scheduler) ─────────────────────────
MEAL_PLAN_BREAKFAST_TIME=07:30           # HH:MM local time
MEAL_PLAN_LUNCH_TIME=12:30
MEAL_PLAN_DINNER_TIME=19:00
MEAL_PLAN_TIMEZONE=Asia/Kolkata

# ── MCP Server Secrets (used by mcp.json) ───────────────────
MCP_FETCH_TIMEOUT=30000                   # ms timeout for fetch MCP requests
MCP_FILESYSTEM_READ_ONLY=true

# ── Frontend (Vite build-time — prefix with VITE_) ──────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3001
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
